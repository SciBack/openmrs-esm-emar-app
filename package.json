{
  "name": "openmrs-esm-emar-app",
  "version": "0.2.0",
  "license": "MPL-2.0",
  "author": "SciBack",
  "description": "Electronic medication administration record (eMAR) for OpenMRS 3",
  "browser": "dist/openmrs-esm-emar-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "build": "rspack --mode production",
    "build:development": "rspack --mode development",
    "analyze": "rspack --mode=production --env.analyze=true",
    "serve": "rspack serve --mode=development",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typescript": "tsc",
    "lint": "eslint src",
    "extract-translations": "i18next \"src/**/*.{ts,tsx}\" \"!src/**/*.test.{ts,tsx}\" --config ./tools/i18next-parser.config.js",
    "prettier": "prettier --config prettier.config.js --write \"src/**/*.{ts,tsx,css,scss}\"",
    "pack": "yarn build && npm pack",
    "verify": "yarn lint && yarn typescript && yarn test",
    "test:e2e": "e2e/run-e2e.sh"
  },
  "keywords": [
    "openmrs",
    "microfrontends",
    "emar",
    "medication administration"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@carbon/react": "^1.83.0"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "10.x",
    "@openmrs/esm-patient-common-lib": "12.x",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-is": "18.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "sass": "1.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/eslint-config": "^2.0.0",
    "@openmrs/esm-framework": "10.0.0",
    "@openmrs/esm-patient-common-lib": "12.3.4",
    "@playwright/test": "^1.56",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dayjs": "^1.11.13",
    "eslint": "^9.39.0",
    "husky": "^9.0.11",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^15.2.2",
    "openmrs": "10.0.0",
    "prettier": "^3.2.5",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-i18next": "^16.0.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "sass": "^1.33.0",
    "single-spa": "^6.0.0",
    "swr": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  },
  "packageManager": "yarn@4.10.3"
}
