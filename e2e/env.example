# Copy to e2e/.env (git-ignored). Fictitious data on a disposable server only.
E2E_BASE_URL=http://localhost:8080
E2E_BACKEND=http://127.0.0.1:8097/openmrs
E2E_NURSE_USER=
E2E_NURSE_PASS=
E2E_TECH_USER=htest.tech
E2E_TECH_PASS=
E2E_ADMIN_USER=              # only to toggle emar.restrictedMedicationConcepts
E2E_ADMIN_PASS=
E2E_PATIENT=                 # fictitious patient uuid (e.g. identifier 99999901)
E2E_LOCATION=                # session location uuid
E2E_ORDER_DRUG=              # regex matching the drug of an active order of the patient (e.g. Medroxyprogesterone)
E2E_ADHOC_DRUG_SEARCH=       # text typed in the drug search for the ad hoc case
E2E_ORDERER_SEARCH=          # text typed in the provider search (ordering clinician)
E2E_RESTRICTED_CONCEPT=      # concept uuid of a drug the patient has an order for, to test masking
E2E_RESTRICTED_DRUG=         # regex matching that drug's name
